---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with Paul Cramer, RMT at PainFreeTendon.">

  <section class="bg-gradient-to-br from-[#f8fbff] to-[#eef5ff] py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-16 items-start max-w-4xl">

        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-teal block mb-5">Contact</span>
          <h1 class="text-4xl font-extrabold text-slate leading-tight tracking-tight mb-5">Get in touch</h1>
          <p class="text-lg text-slate-mid leading-relaxed mb-8">
            Have a question about tendon pain, the site, or working with Paul? Use the form and he'll get back to you within 24–48 hours.
          </p>

          <div class="flex flex-col gap-4">
            <div class="flex items-center gap-3 text-sm text-slate-mid">
              <div class="w-9 h-9 rounded-xl bg-blue-light flex items-center justify-center flex-shrink-0">📧</div>
              <span>paul@movementspark.com</span>
            </div>
            <div class="flex items-center gap-3 text-sm text-slate-mid">
              <div class="w-9 h-9 rounded-xl bg-teal-light flex items-center justify-center flex-shrink-0">🌐</div>
              <span>painfreetendon.com</span>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-card border border-gray-100 p-8">
          <form class="flex flex-col gap-4">
            <div>
              <label class="text-xs font-semibold text-slate-mid block mb-1.5">Name</label>
              <input type="text" class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue/20" />
            </div>
            <div>
              <label class="text-xs font-semibold text-slate-mid block mb-1.5">Email</label>
              <input type="email" class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue/20" />
            </div>
            <div>
              <label class="text-xs font-semibold text-slate-mid block mb-1.5">Message</label>
              <textarea rows="5" class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue/20 resize-none"></textarea>
            </div>
            <button type="submit" class="btn-primary justify-center text-sm">Send message →</button>
          </form>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>
