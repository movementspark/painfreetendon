  <section class="bg-gradient-to-br from-[#f8fbff] to-[#eef5ff] py-20">
    <div class="max-w-6xl mx-auto px-6">
      <span class="text-xs font-bold uppercase tracking-widest text-teal block mb-4">Resources</span>
      <h1 class="text-4xl md:text-5xl font-extrabold text-slate leading-tight tracking-tight mb-5">
        Everything you need to<br/>understand tendon rehab
      </h1>
      <p class="text-lg text-slate-mid max-w-xl leading-relaxed">
        Articles, guides, and future video content — all built around one goal: giving you a clear, evidence-informed understanding of what your tendon needs.
      </p>
    </div>
  </section>

  <!-- FILTER TAGS -->
  <section class="sticky top-20 z-40 bg-white border-b border-gray-100 py-4">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex gap-2 overflow-x-auto scrollbar-hide">
        {topics.map((t, i) => (
          <button
            data-filter={t}
            class:list={[
              'flex-shrink-0 text-xs font-bold uppercase tracking-wider px-4 py-2 rounded-full transition-colors duration-150',
              i === 0
                ? 'bg-blue text-white'
                : 'bg-bg-alt text-slate-mid hover:bg-blue-light hover:text-blue',
            ]}>
            {t}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ARTICLES -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <span class="badge">Articles</span>
      <h2 class="section-title mb-10">Latest articles</h2>

      {publishedArticles.length === 0 ? (
        <div class="bg-bg-alt rounded-2xl border border-gray-100 p-12 text-center max-w-xl mx-auto">
          <div class="text-3xl mb-4">✍️</div>
          <h3 class="font-bold text-slate mb-2">First articles coming shortly</h3>
          <p class="text-sm text-slate-soft leading-relaxed mb-6">
            Evidence-informed articles on Achilles tendinopathy, progressive loading, pain science and more are being prepared. Sign up below to get them in your inbox as they publish.
          </p>
          <a href="#subscribe" class="btn-primary text-sm">Notify me →</a>
        </div>
      ) : (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[...publishedArticles].reverse().map(a => (
          <article data-category={a.category} class="bg-white rounded-2xl border border-gray-100 shadow-card overflow-hidden flex flex-col hover:shadow-card-md hover:-translate-y-1 transition-all duration-200">
            {(a.thumbnail ?? heroImages[a.href]) ? (
              <div class="h-36 overflow-hidden">
                <img src={a.thumbnail ?? heroImages[a.href]} alt={a.title} class="w-full h-full object-cover" />
              </div>
            ) : (
              <div class="h-36 bg-gradient-to-br from-bg-alt to-blue-light flex items-center justify-center">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none" opacity=".3">
                  <rect x="8" y="8" width="32" height="32" rx="6" stroke="#1D6FD8" stroke-width="2"/>
                  <path d="M16 20H32M16 26H28M16 32H24" stroke="#1D6FD8" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </div>
            )}

            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center justify-between mb-3">
                <span class={`text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full ${a.color}`}>
                  {a.category}
                </span>
                <span class="text-xs text-slate-soft">{a.time}</span>
              </div>
              <h3 class="font-bold text-slate mb-2 leading-snug">{a.title}</h3>
              <p class="text-sm text-slate-soft leading-relaxed flex-1 mb-5">{a.excerpt}</p>
              <a href={a.href} class="btn-ghost text-sm text-blue">
                Read article
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path d="M2 7H12M8 3L12 7L8 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
      )}
    </div>
  </section>

  <!-- GUIDES / DOWNLOADS -->
  <section id="guides" class="py-20 bg-bg-alt">
    <div class="max-w-6xl mx-auto px-6">
      <span class="badge badge-teal">Free Guides</span>
      <h2 class="section-title mb-4">Downloadable guides</h2>
      <p class="section-sub max-w-md mb-10">Practical one-page references you can save and use during your rehab program.</p>

      <div class="grid md:grid-cols-3 gap-6">
        {guides.map(g => (
          <div class="bg-white rounded-2xl border border-gray-100 p-7 shadow-card flex flex-col gap-4">
            <div class="w-12 h-12 rounded-xl bg-teal-light flex items-center justify-center text-xl">
              {g.icon}
            </div>
            <div>
              <h3 class="font-bold text-slate mb-1.5">{g.title}</h3>
              <p class="text-sm text-slate-soft leading-relaxed">{g.desc}</p>
            </div>
            <a
              href={g.href}
              download
              class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider px-4 py-2 rounded-full bg-teal text-white hover:bg-teal/90 transition-colors self-start"
            >
              <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                <path d="M6.5 1v7M3.5 5.5l3 3 3-3M2 11h9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Download PDF
            </a>
          </div>
        ))}
      </div>

      <!-- Email capture -->
      <div id="subscribe" class="mt-12 bg-blue-light rounded-2xl p-8 border border-blue/15">
        <div class="max-w-lg">
          <h3 class="text-xl font-bold text-slate mb-2">Get the free Achilles Recovery Guide</h3>
          <p class="text-sm text-slate-mid mb-5">Sign up to receive our comprehensive 12-page guide on loading progressions, morning stiffness rules, and pain monitoring — sent straight to your inbox.</p>
          <a
            href="https://programs.painfreetendon.com/morning-stiffness"
            class="btn-primary inline-block text-sm"
          >
            Get the Free Guide →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- VIDEO (placeholder) -->
  <section id="videos" class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <span class="badge">Video</span>
      <h2 class="section-title mb-4">Video content</h2>
      <p class="section-sub max-w-md mb-10">Video explanations and exercise demonstrations — coming soon.</p>

      <div class="grid md:grid-cols-3 gap-6">
        {[1,2,3].map(() => (
          <div class="bg-bg-alt rounded-2xl aspect-video flex items-center justify-center border border-gray-100">
            <div class="text-center">
              <div class="w-14 h-14 rounded-full bg-white border border-gray-100 shadow-card flex items-center justify-center mx-auto mb-3">
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                  <path d="M8 6L17 11L8 16V6Z" fill="#1D6FD8"/>
                </svg>
              </div>
              <p class="text-xs text-slate-soft font-medium">Coming soon</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll('[data-filter]');
    const cards   = document.querySelectorAll('[data-category]');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;
        buttons.forEach(b => {
          b.classList.remove('bg-blue', 'text-white');
          b.classList.add('bg-bg-alt', 'text-slate-mid');
        });
        btn.classList.add('bg-blue', 'text-white');
        btn.classList.remove('bg-bg-alt', 'text-slate-mid');
        cards.forEach(card => {
          card.style.display = (filter === 'All' || card.dataset.category === filter) ? '' : 'none';
        });
      });
    });
  </script>

  <CTABanner
    badge="Ready for a program?"
    title="Turn this education into action"
    body="Browse structured rehab programs built around the same principles as everything you've read here."
    primaryCta={{ label: 'View Programs →', href: '/programs' }}
    secondaryCta={{ label: 'Work with Paul', href: '/book' }}
    variant="dark"
  />

</BaseLayout>
