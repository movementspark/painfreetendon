---
import BaseLayout from '@layouts/BaseLayout.astro';
import CTABanner  from '@components/CTABanner.astro';

// Auto-detect heroImage from every blog post file at build time
const blogSources = import.meta.glob('./blog/*.astro', { query: '?raw', import: 'default' });
const heroImages: Record<string, string> = {};
for (const [path, loader] of Object.entries(blogSources)) {
  const content = await (loader as () => Promise<string>)();
  const slug = path.replace('./blog/', '').replace('.astro', '');
  const match = (content as string).match(/heroImage="([^"]+)"/);
  if (match) heroImages[`/blog/${slug}`] = match[1];
}

