---
import BaseLayout from '@layouts/BaseLayout.astro';
import CTABanner  from '@components/CTABanner.astro';

const philosophy = [
  {
    title: 'Capacity over symptom chasing',
    body:  'Chasing pain relief without addressing capacity is like fixing a leaking tap by turning off the water. The goal is always to build a tendon that can handle what life demands of it — not just one that temporarily stops hurting.',
    color: 'blue',
  },
  {
    title: 'Pain is information, not damage',
    body:  'Modern pain science has fundamentally changed how we think about tendon pain. Pain reflects the nervous system\'s assessment of threat — and that threat perception can be changed. Understanding this is one of the most powerful tools in recovery.',
    color: 'teal',
  },
  {
    title: 'Clarity reduces fear, fear prolongs pain',
    body:  'Most people with tendon pain are stuck because they\'re confused and scared. When they understand what\'s happening, why, and what to do about it — their outcomes improve. That\'s the whole point of this site.',
    color: 'blue',
  },
  {
    title: 'Guided process beats guesswork',
    body:  'Recovery isn\'t complicated once you have the right map. A structured, progressive approach removes the uncertainty, the setbacks, and the frustration — and replaces them with a clear path forward.',
    color: 'teal',
  },
];

const timeline = [
  {
    year:  'Early career',
    title: 'RMT training and clinical focus',
    body:  'Paul trained as a Registered Massage Therapist and quickly developed a deep interest in persistent pain — particularly musculoskeletal presentations that weren\'t responding to standard approaches.',
  },
  {
    year:  'Clinical experience',
    title: 'Specialising in tendon rehabilitation',
    body:  'Working with runners, athletes, and active people navigating tendon pain, Paul developed a practice grounded in progressive loading, pain science education, and honest patient communication.',
  },
  {
    year:  'PainFreeTendon',
    title: 'Bringing the approach online',
    body:  'Frustrated by the lack of clear, accessible guidance online for tendon pain, Paul launched PainFreeTendon — a hub for evidence-informed education, structured programs, and eventually virtual consultations.',
  },
];

const roadmap = [
  { label: 'Phase 1 — Now',    desc: 'Education hub + structured programs',  done: true  },
  { label: 'Phase 2 — Soon',   desc: 'Virtual telehealth consultations',      done: false },
  { label: 'Phase 3 — Future', desc: 'Personalised outcome tracking',         done: false },
];
---

<BaseLayout
  title="About Paul Cramer, RMT"
  description="Paul Cramer, RMT — Registered Massage Therapist and founder of PainFreeTendon. Clinician, educator, and advocate for evidence-informed tendon rehab."
>

  <!-- ── HERO ── -->
  <section class="bg-gradient-to-br from-[#f8fbff] via-[#eef5ff] to-[#f0fbf9] py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-16 items-center">

        <!-- Copy -->
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-teal mb-5">About</p>

          <h1 class="text-4xl md:text-5xl font-extrabold text-slate leading-[1.08] tracking-tight mb-6">
            Paul Cramer, <span class="text-blue">RMT</span>
          </h1>

          <p class="text-lg text-slate-mid leading-relaxed mb-4 max-w-lg">
            I'm a Registered Massage Therapist with a clinical focus on tendon pain and rehabilitation.
            I created PainFreeTendon because the gap between what the research says and what people
            actually hear is enormous — and it keeps people stuck.
          </p>
          <p class="text-lg text-slate-mid leading-relaxed mb-8 max-w-lg">
            My approach is simple: understand what the tendon needs, build capacity progressively,
            and stop being afraid of the pain that's guiding you through the process.
          </p>

          <div class="flex flex-wrap gap-3 mb-8">
            <a href="/book"      class="btn-primary">Book a Virtual Session →</a>
            <a href="/resources" class="btn-outline">Browse Resources</a>
          </div>

          <!-- Credential chips -->
          <div class="flex flex-wrap gap-2 items-center">
            <span class="text-xs font-semibold text-slate-mid bg-bg-alt border border-[#e4e9f2] rounded-full px-4 py-1.5">
              Registered Massage Therapist
            </span>
            <span class="text-xs font-semibold text-slate-mid bg-bg-alt border border-[#e4e9f2] rounded-full px-4 py-1.5">
              Tendon Rehab Specialist
            </span>
            <span class="text-xs font-semibold text-slate-mid bg-bg-alt border border-[#e4e9f2] rounded-full px-4 py-1.5">
              MovementSpark Health
            </span>
          </div>
        </div>

        <!-- Circle photo + trust badge -->
        <div class="flex flex-col items-center gap-7">
          <div class="w-72 h-72 md:w-80 md:h-80 rounded-full overflow-hidden shadow-card-md flex-shrink-0">
            <img
              src="/paul-cramer.png"
              alt="Paul Cramer, RMT"
              class="w-full h-full object-cover object-top"
            />
          </div>

          <div class="bg-white rounded-2xl shadow-card border border-gray-100 px-5 py-4 flex items-center gap-4 max-w-[280px]">
            <div class="w-10 h-10 rounded-xl bg-teal-light flex items-center justify-center flex-shrink-0">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M4 10L8 14L16 6" stroke="#0D9A8A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-bold text-slate leading-snug mb-0.5">Evidence-informed</p>
              <p class="text-xs text-slate-soft">Clinically grounded guidance</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── WHY THIS EXISTS ── -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-20 items-start">

        <div>
          <span class="badge">Why PainFreeTendon Exists</span>
          <h2 class="section-title mb-6">The clarity<br/>that was missing</h2>

          <blockquote class="border-l-[3px] border-teal pl-5">
            <p class="text-xl font-bold text-slate italic leading-relaxed">
              "They stopped being afraid of movement and started working
              <em>with</em> their tendon instead of around it."
            </p>
          </blockquote>
        </div>

        <div class="pt-2">
          <p class="text-base text-slate-mid leading-relaxed mb-5">
            In clinical practice, I kept seeing the same story: someone comes in with Achilles pain
            they've had for two years. They've been told to rest it, ice it, stretch it, tape it.
            Nothing has worked — because none of those things addressed what the tendon actually needs.
          </p>
          <p class="text-base text-slate-mid leading-relaxed mb-5">
            When I explained the tendon loading model — that the pain wasn't because they were broken,
            but because the tendon's capacity hadn't kept up with the demands placed on it — something
            shifted.
          </p>
          <p class="text-base text-slate-mid leading-relaxed">
            PainFreeTendon is my attempt to make that shift available to everyone — not just the people
            lucky enough to find the right clinician. The information is clear, the programs are
            structured, and the goal is always the same: build capacity, stop managing symptoms.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ── PHILOSOPHY ── -->
  <section id="philosophy" class="py-20 bg-bg-alt">
    <div class="max-w-6xl mx-auto px-6">
      <span class="badge badge-teal">Clinical Philosophy</span>
      <h2 class="section-title mb-12">How I think about tendon pain</h2>

      <div class="grid md:grid-cols-2 gap-6">
        {philosophy.map(p => (
          <div class="card p-7">
            <div class:list={[
              'w-12 h-12 rounded-xl flex items-center justify-center mb-5',
              p.color === 'teal' ? 'bg-teal-light' : 'bg-blue-light',
            ]}>
              <div class:list={[
                'w-[18px] h-[18px] rounded-full opacity-70',
                p.color === 'teal' ? 'bg-teal' : 'bg-blue',
              ]}></div>
            </div>
            <h3 class="font-bold text-slate mb-3">{p.title}</h3>
            <p class="text-sm text-slate-soft leading-relaxed">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── TIMELINE ── -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <span class="badge">Background</span>
      <h2 class="section-title mb-12">The path to PainFreeTendon</h2>

      <div class="relative flex flex-col gap-0 max-w-2xl">
        <!-- Vertical line -->
        <div class="absolute left-5 top-5 bottom-5 w-0.5 bg-blue-light rounded-full"></div>

        {timeline.map((item, i) => (
          <div class="relative flex gap-8 pb-12 last:pb-0">
            <div class="w-10 h-10 rounded-full bg-blue text-white text-sm font-bold flex items-center justify-center flex-shrink-0 z-10 ring-4 ring-white">
              {i + 1}
            </div>
            <div class="pt-1">
              <span class="text-xs font-bold uppercase tracking-widest text-blue block mb-1.5">
                {item.year}
              </span>
              <h3 class="font-bold text-slate mb-2">{item.title}</h3>
              <p class="text-sm text-slate-soft leading-relaxed">{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FUTURE VISION ── -->
  <section class="py-20 md:py-28 bg-gradient-to-br from-slate via-[#1A3060] to-slate">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-20 items-center">

        <div>
          <span class="inline-block text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full mb-5 bg-white/10 text-white/75">
            What's Coming
          </span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-white leading-tight tracking-tight mb-5">
            The future of PainFreeTendon
          </h2>
          <p class="text-white/65 leading-relaxed mb-4">
            The current phase is focused on education and structured self-guided programs. The next
            phase brings personalised care online — virtual telehealth consultations, individualised
            loading programs, and outcome tracking that keeps you accountable.
          </p>
          <p class="text-white/65 leading-relaxed mb-8">
            The vision: a platform where anyone, anywhere, can access expert tendon guidance without
            the barriers of geography, waitlists, or cost.
          </p>
          <a href="/book" class="btn-primary">Get notified when telehealth launches →</a>
        </div>

        <!-- Roadmap -->
        <div class="flex flex-col gap-4">
          {roadmap.map(r => (
            <div class:list={[
              'flex items-center gap-4 rounded-xl border px-5 py-4',
              r.done
                ? 'bg-teal/15 border-teal/35'
                : 'bg-white/6 border-white/10',
            ]}>
              <div class:list={[
                'w-8 h-8 rounded-full flex-shrink-0 flex items-center justify-center',
                r.done ? 'bg-teal' : 'bg-white/10',
              ]}>
                {r.done
                  ? <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M3 8L6.5 11.5L13 5" stroke="white" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  : <div class="w-2 h-2 rounded-full bg-white/30"></div>
                }
              </div>
              <div>
                <p class:list={[
                  'text-sm font-bold mb-0.5',
                  r.done ? 'text-teal' : 'text-white/80',
                ]}>
                  {r.label}
                </p>
                <p class="text-sm text-white/45">{r.desc}</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <CTABanner
    badge="Work with Paul"
    title="Have a complex case or want 1-on-1 guidance?"
    body="Virtual sessions with Paul give you an individualised assessment, a clear plan, and the confidence to follow through."
    primaryCta={{ label: 'Book a Virtual Session →', href: '/book' }}
    secondaryCta={{ label: 'Browse programs', href: '/programs' }}
    variant="teal"
  />

</BaseLayout>
