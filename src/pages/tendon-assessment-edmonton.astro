  </div>

  <script is:inline>
    (function () {
      var UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
      function withUtm(baseUrl) {
        try {
          var pageParams = new URLSearchParams(window.location.search);
          var url = new URL(baseUrl, window.location.href);
          UTM_KEYS.forEach(function (key) {
            if (pageParams.has(key)) url.searchParams.set(key, pageParams.get(key));
          });
          return url.toString();
        } catch (e) {
          return baseUrl;
        }
      }
      document.querySelectorAll('[data-booking]').forEach(function (el) {
        el.setAttribute('href', withUtm(el.getAttribute('href')));
        el.addEventListener('click', function () {
          if (window.va) window.va('event', { name: 'booking_click', source: el.getAttribute('data-booking-source') || 'unknown' });
        });
      });
    })();
  </script>
