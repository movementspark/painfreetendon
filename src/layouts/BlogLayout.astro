---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title:           string;
  description:     string;
  category:        string;
  readTime:        string;
  date:            string;
  draft?:          boolean;
  heroImage?:      string;
  heroImageAlt?:   string;
}

const { title, description, category, readTime, date, draft = false, heroImage, heroImageAlt } = Astro.props;

const ogImage = heroImage ?? '/og-default.png';
const canonicalURL = new URL(Astro.url.pathname, 'https://painfreetendon.com').href;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": date,
  "author": {
    "@type": "Person",
    "name": "Paul Cramer, RMT",
    "url": "https://painfreetendon.com/about"
  },
  "publisher": {
    "@type": "Organization",
    "name": "PainFreeTendon",
    "url": "https://painfreetendon.com"
  },
  "image": heroImage ? `https://painfreetendon.com${heroImage}` : "https://painfreetendon.com/og-default.png",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL
  }
});

const categoryColors: Record<string, string> = {
  'Pain Science':    'bg-blue-light text-blue',
  'Achilles':        'bg-blue-light text-blue',
  'Loading':         'bg-teal-light text-teal',
  'Tennis Elbow':    'bg-teal-light text-teal',
  'Recovery':        'bg-orange-50 text-orange-600',
  'Research':        'bg-violet-50 text-violet-600',
  'For Clinicians':  'bg-violet-50 text-violet-600',
  'Running':         'bg-teal-light text-teal',
  'Exercise':        'bg-blue-light text-blue',
  'Symptoms':        'bg-teal-light text-teal',
  'Nutrition':       'bg-teal-light text-teal',
  'Rehabilitation':  'bg-blue-light text-blue',
};
const catColor = categoryColors[category] ?? 'bg-bg-alt text-slate-mid';

// Category-specific CTAs
type CtaConfig = { heading: string; body: string; primary: { label: string; href: string }; secondary: { label: string; href: string } };
const categoryCtaMap: Record<string, CtaConfig> = {
  'Achilles': {
    heading: 'Ready to follow a structured Achilles program?',
    body: 'The 12-week Achilles program takes you from pain relief through progressive loading all the way back to full activity — step by step.',
    primary: { label: 'Start the Achilles Program →', href: 'https://programs.painfreetendon.com/achilles-program' },
    secondary: { label: 'Book a 1-on-1 session', href: '/book' },
  },
  'Running': {
    heading: 'Want a structured plan to get back to running?',
    body: 'The 12-week Achilles program includes a progressive return-to-running protocol built around your tendon\'s actual readiness.',
    primary: { label: 'Start the Achilles Program →', href: 'https://programs.painfreetendon.com/achilles-program' },
    secondary: { label: 'Book a 1-on-1 session', href: '/book' },
  },
  'Exercise': {
    heading: 'Want the full progressive loading program?',
    body: 'The 12-week Achilles program walks you through every phase — isometrics, bilateral raises, single-leg loading, and heavy slow resistance.',
    primary: { label: 'Start the Achilles Program →', href: 'https://programs.painfreetendon.com/achilles-program' },
    secondary: { label: 'Book a 1-on-1 session', href: '/book' },
  },
  'Tennis Elbow': {
    heading: 'Working through tennis elbow?',
    body: 'A structured program for lateral epicondylitis is in development. Join the waitlist and get notified when it launches — plus the free Tennis Elbow Starter Guide in the meantime.',
    primary: { label: 'Join the Tennis Elbow Waitlist →', href: 'https://programs.painfreetendon.com/tennis-elbow-waitlist' },
    secondary: { label: 'Book a 1-on-1 session', href: '/book' },
  },
  'Recovery': {
    heading: 'Not sure where you are in your recovery?',
    body: 'A 1-on-1 virtual session gives you a clear assessment, a personalised loading plan, and a realistic timeline — based on your specific situation.',
    primary: { label: 'Book a Session with Paul →', href: '/book' },
    secondary: { label: 'Browse the Achilles Program', href: '/programs' },
  },
  'Symptoms': {
    heading: 'Want a clear plan for your tendon symptoms?',
    body: 'The 12-week Achilles program takes the guesswork out — giving you a stage-by-stage protocol with clear pain guidelines at every step.',
    primary: { label: 'Start the Achilles Program →', href: 'https://programs.painfreetendon.com/achilles-program' },
    secondary: { label: 'Book a 1-on-1 session', href: '/book' },
  },
};
const defaultCta: CtaConfig = {
  heading: 'Ready to take the next step?',
  body: 'Browse structured rehab programs or book a 1-on-1 session with Paul to get a personalised plan.',
  primary: { label: 'View Programs →', href: '/programs' },
  secondary: { label: 'Book a Session', href: '/book' },
};
const cta = categoryCtaMap[category] ?? defaultCta;
---

<BaseLayout title={title} description={description} ogImage={ogImage} ogType="article">
  <script type="application/ld+json" set:html={jsonLd} slot="head" />

  {draft && (
    <div class="bg-orange-50 border-b border-orange-200 py-2 px-6 text-center text-xs font-semibold text-orange-600">
      ⚠️ Draft — not yet published
    </div>
  )}

  <!-- Article header -->
  <section class="bg-gradient-to-br from-[#f8fbff] to-[#eef5ff] py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6">
      <div class="flex items-center gap-3 mb-5">
        <a href="/resources" class="text-xs font-semibold text-slate-soft hover:text-blue transition-colors flex items-center gap-1">
          ← Resources
        </a>
        <span class="text-slate-soft/40">·</span>
        <span class={`text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full ${catColor}`}>
          {category}
        </span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold text-slate leading-tight tracking-tight mb-5">
        {title}
      </h1>
      <p class="text-lg text-slate-mid leading-relaxed mb-6">{description}</p>
      <div class="flex items-center gap-4 text-xs text-slate-soft">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full overflow-hidden bg-blue-light flex-shrink-0">
            <img src="/paul-cramer.png" alt="Paul Cramer" class="w-full h-full object-cover object-top" />
          </div>
          <span class="font-semibold text-slate-mid">Paul Cramer, RMT</span>
        </div>
        <span>·</span>
        <span>{date}</span>
        <span>·</span>
        <span>{readTime}</span>
      </div>
    </div>
  </section>

  <!-- Featured image -->
  {heroImage && (
    <div class="w-full bg-white">
      <div class="max-w-3xl mx-auto px-6 pt-10">
        <img
          src={heroImage}
          alt={heroImageAlt ?? title}
          class="w-full rounded-2xl shadow-card object-cover"
          style="max-height: 420px;"
        />
      </div>
    </div>
  )}

  <!-- Article body -->
  <article class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-6">
      <div class="prose-article">
        <slot />
      </div>

      <!-- Mid-article email capture -->
      <div class="my-10 bg-gradient-to-br from-[#EBF3FF] to-[#E6F8F5] rounded-2xl p-8 border border-blue/10">
        <div class="flex flex-col sm:flex-row sm:items-center gap-5">
          <div class="flex-1">
            <p class="text-xs font-bold uppercase tracking-widest text-blue mb-2">Free guide</p>
            <h3 class="text-lg font-extrabold text-slate mb-1">Get the free Achilles Recovery Guide</h3>
            <p class="text-sm text-slate-mid leading-relaxed">12 pages covering loading progressions, pain monitoring, morning stiffness, and more.</p>
          </div>
          <a
            href="https://programs.painfreetendon.com/morning-stiffness"
            class="btn-primary text-sm whitespace-nowrap flex-shrink-0"
          >
            Get the Free Guide →
          </a>
        </div>
      </div>

      <!-- Author bio -->
      <div class="mt-10 pt-8 border-t border-gray-100 flex items-start gap-5">
        <div class="w-14 h-14 rounded-full overflow-hidden bg-blue-light flex-shrink-0">
          <img src="/paul-cramer.png" alt="Paul Cramer" class="w-full h-full object-cover object-top" />
        </div>
        <div>
          <p class="font-bold text-slate mb-1">Paul Cramer, RMT</p>
          <p class="text-sm text-slate-soft leading-relaxed">
            Registered Massage Therapist with a clinical focus on tendon rehabilitation. Founder of PainFreeTendon — evidence-informed guidance for people with tendon pain.
          </p>
          <a href="/about" class="text-sm font-semibold text-blue hover:underline mt-2 inline-block">Read more about Paul →</a>
        </div>
      </div>
    </div>
  </article>

  <!-- Bottom CTA — category-specific -->
  <section class="py-16 bg-bg-teal border-t border-teal/10">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-extrabold text-slate mb-3">{cta.heading}</h2>
      <p class="text-slate-mid text-sm mb-6 max-w-xl mx-auto">{cta.body}</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href={cta.primary.href} class="btn-primary text-sm">{cta.primary.label}</a>
        <a href={cta.secondary.href} class="btn-outline text-sm">{cta.secondary.label}</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style is:global>
  .prose-article {
    font-size: 1rem;
    line-height: 1.8;
    color: #3D4E6B;
  }
  .prose-article h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #1A2540;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    letter-spacing: -.02em;
    line-height: 1.3;
  }
  .prose-article h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #1A2540;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .prose-article p {
    margin-bottom: 1.25rem;
  }
  .prose-article ul, .prose-article ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .prose-article ul { list-style: disc; }
  .prose-article ol { list-style: decimal; }
  .prose-article li { line-height: 1.7; }
  .prose-article strong { color: #1A2540; font-weight: 700; }
  .prose-article a { color: #1D6FD8; text-decoration: underline; }
  .prose-article blockquote {
    border-left: 4px solid #0D9A8A;
    padding: 1rem 1.25rem;
    background: #F0FBF9;
    border-radius: 0 10px 10px 0;
    margin: 1.5rem 0;
    font-style: italic;
    color: #1A2540;
  }
  .prose-article .callout {
    background: #EBF3FF;
    border-left: 4px solid #1D6FD8;
    padding: 1rem 1.25rem;
    border-radius: 0 10px 10px 0;
    margin: 1.5rem 0;
    font-size: .93rem;
  }
  .prose-article .callout strong { color: #1558B0; }
  .prose-article hr {
    border: none;
    border-top: 1px solid #E2E8F4;
    margin: 2rem 0;
  }
</style>
