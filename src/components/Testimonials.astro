---
import { testimonials } from '@data/testimonials.js';

interface Props {
  variant?: 'home' | 'full';
}

const { variant = 'full' } = Astro.props;
---

{variant === 'home' ? (
  <section class="py-20 bg-bg-alt">
    <div class="max-w-6xl mx-auto px-6">
      <span class="badge badge-teal">Client Stories</span>
      <h2 class="section-title mb-3">What clients are saying</h2>
      <p class="section-sub max-w-lg mb-12">Real outcomes from people who came in stuck, frustrated, and out of options.</p>

      <div class="grid md:grid-cols-3 gap-6 mb-10">
        {testimonials.map(t => (
          <div class="card p-7 flex flex-col">
            <svg width="26" height="20" viewBox="0 0 28 22" class="text-blue-light mb-4">
              <path d="M0 22V13.2C0 8.8 1.1 5.5 3.3 3.3 5.5 1.1 8.3 0 11.7 0V4.4C9.9 4.4 8.5 5 7.5 6.2C6.5 7.4 6 9 6 11H11.7V22H0ZM16.3 22V13.2C16.3 8.8 17.4 5.5 19.6 3.3C21.8 1.1 24.6 0 28 0V4.4C26.2 4.4 24.8 5 23.8 6.2C22.8 7.4 22.3 9 22.3 11H28V22H16.3Z" fill="currentColor" />
            </svg>
            <p class="text-sm text-slate-mid leading-relaxed italic mb-5 flex-1">"{t.highlight}"</p>
            <div class="border-t border-gray-100 pt-4">
              <p class="text-sm font-bold text-slate">{t.name}</p>
              <p class="text-xs text-slate-soft">{t.condition}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center">
        <a href="/testimonials" class="btn-ghost">
          Read the full stories
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M2 7H12M8 3L12 7L8 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
) : (
  <div class="flex flex-col gap-8 max-w-3xl mx-auto">
    {testimonials.map(t => (
      <div class="card p-8 md:p-10">
        <svg width="30" height="24" viewBox="0 0 28 22" class="text-blue-light mb-5">
          <path d="M0 22V13.2C0 8.8 1.1 5.5 3.3 3.3 5.5 1.1 8.3 0 11.7 0V4.4C9.9 4.4 8.5 5 7.5 6.2C6.5 7.4 6 9 6 11H11.7V22H0ZM16.3 22V13.2C16.3 8.8 17.4 5.5 19.6 3.3C21.8 1.1 24.6 0 28 0V4.4C26.2 4.4 24.8 5 23.8 6.2C22.8 7.4 22.3 9 22.3 11H28V22H16.3Z" fill="currentColor" />
        </svg>
        {t.quote.split('\n\n').map(paragraph => (
          <p class="text-base text-slate-mid leading-relaxed mb-4 last:mb-0">{paragraph}</p>
        ))}
        <div class="border-t border-gray-100 mt-6 pt-5 flex items-center justify-between flex-wrap gap-2">
          <p class="font-bold text-slate">— {t.name}</p>
          <span class="text-xs font-semibold text-teal bg-teal-light px-3 py-1 rounded-full">{t.condition}</span>
        </div>
      </div>
    ))}
  </div>
)}
