---
interface Props {
  badge?:       string;
  title:        string;
  body:         string;
  primaryCta:   { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  variant?:     'blue' | 'teal' | 'dark';
}

const {
  badge,
  title,
  body,
  primaryCta,
  secondaryCta,
  variant = 'teal',
} = Astro.props;

const bgMap = {
  blue: 'bg-blue-light',
  teal: 'bg-bg-teal',
  dark: 'bg-slate',
};
const textMap = {
  blue: 'text-slate',
  teal: 'text-slate',
  dark: 'text-white',
};
const subMap = {
  blue: 'text-slate-mid',
  teal: 'text-slate-mid',
  dark: 'text-white/65',
};
const badgeMap = {
  blue: 'bg-blue/10 text-blue',
  teal: 'bg-teal/10 text-teal',
  dark: 'bg-white/10 text-white/80',
};
---

<section class={`py-20 ${bgMap[variant]}`}>
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto">
      {badge && (
        <span class={`inline-block text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full mb-4 ${badgeMap[variant]}`}>
          {badge}
        </span>
      )}
      <h2 class={`text-3xl md:text-4xl font-extrabold leading-tight tracking-tight mb-4 ${textMap[variant]}`}>
        {title}
      </h2>
      <p class={`text-base leading-relaxed mb-8 ${subMap[variant]}`}>{body}</p>

      <div class="flex flex-wrap gap-3 justify-center">
        {variant === 'dark'
          ? <>
              <a href={primaryCta.href} class="btn-primary">{primaryCta.label}</a>
              {secondaryCta && (
                <a href={secondaryCta.href}
                   class="inline-flex items-center gap-2 bg-white/10 text-white font-semibold px-6 py-3 rounded-lg border border-white/20 hover:bg-white/20 transition-all duration-200">
                  {secondaryCta.label}
                </a>
              )}
            </>
          : <>
              <a href={primaryCta.href} class="btn-primary">{primaryCta.label}</a>
              {secondaryCta && (
                <a href={secondaryCta.href} class="btn-outline">{secondaryCta.label}</a>
              )}
            </>
        }
      </div>
    </div>
  </div>
</section>
