---
interface Props {
  eyebrow?:    string;
  title:       string;
  titleAccent?: string; // word/phrase to highlight in blue
  body:        string;
  primaryCta:  { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  showCard?:   boolean; // show the tracker card on home
}

const {
  eyebrow    = 'Evidence-informed tendon rehab',
  title,
  titleAccent,
  body,
  primaryCta,
  secondaryCta,
  showCard = false,
} = Astro.props;
---

<section class="bg-gradient-to-br from-[#f8fbff] via-[#eef5ff] to-[#f0fbf9] py-20 md:py-28 overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <div class:list={['grid gap-16 items-center', showCard ? 'md:grid-cols-2' : 'max-w-3xl']}>

      <!-- Copy -->
      <div>
        {eyebrow && (
          <p class="text-xs font-bold uppercase tracking-widest text-teal mb-5">{eyebrow}</p>
        )}

        <h1 class="text-4xl md:text-5xl font-extrabold text-slate leading-[1.1] tracking-tight mb-5">
          {titleAccent
            ? (<>
                {title.split(titleAccent)[0]}
                <span class="text-blue relative inline-block">
                  {titleAccent}
                  <span class="absolute -bottom-0.5 left-0 right-0 h-[3px] bg-teal rounded-full"></span>
                </span>
                {title.split(titleAccent)[1]}
              </>)
            : title
          }
        </h1>

        <p class="text-lg text-slate-mid leading-relaxed mb-8 max-w-lg">{body}</p>

        <div class="flex flex-wrap gap-3">
          <a href={primaryCta.href} class="btn-primary">{primaryCta.label}</a>
          {secondaryCta && (
            <a href={secondaryCta.href} class="btn-outline">{secondaryCta.label}</a>
          )}
        </div>

        <p class="mt-6 text-sm text-slate-soft flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <circle cx="8" cy="8" r="7" stroke="#0D9A8A" stroke-width="1.5"/>
            <path d="M5 8L7 10L11 6" stroke="#0D9A8A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Clear guidance from a registered clinician — no hype, no guessing
        </p>
      </div>

      <!-- Hero image -->
      {showCard && (
        <div class="relative flex justify-center items-center">

          <!-- Image with rounded corners + subtle shadow -->
          <div class="relative rounded-3xl overflow-hidden shadow-card-md w-full max-w-sm">
            <img
              src="/hero.jpg"
              alt="Active adults doing tendon rehab exercises"
              class="w-full h-full object-cover"
              width="800"
              height="1000"
              loading="eager"
            />
            <!-- Subtle gradient overlay at bottom so floating badge is readable -->
            <div class="absolute inset-0 bg-gradient-to-t from-slate/40 via-transparent to-transparent"></div>
          </div>

          <!-- Floating trust badge -->
          <div class="absolute bottom-5 left-1/2 -translate-x-1/2 w-[88%] bg-white/95 backdrop-blur-sm rounded-2xl shadow-card px-5 py-4 flex items-center gap-4 border border-white">
            <div class="w-10 h-10 rounded-xl bg-teal-light flex items-center justify-center flex-shrink-0">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M4 10L8 14L16 6" stroke="#0D9A8A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-bold text-slate leading-none mb-1">Build capacity, not just manage symptoms</p>
              <p class="text-xs text-slate-soft">Paul Cramer, RMT · Evidence-informed rehab</p>
            </div>
          </div>

        </div>
      )}
    </div>
  </div>
</section>
