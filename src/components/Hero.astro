---
interface Props {
  eyebrow?:    string;
  title:       string;
  titleAccent?: string; // word/phrase to highlight in blue
  body:        string;
  primaryCta:  { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  showCard?:   boolean; // show the tracker card on home
}

const {
  eyebrow    = 'Evidence-informed tendon rehab',
  title,
  titleAccent,
  body,
  primaryCta,
  secondaryCta,
  showCard = false,
} = Astro.props;
---

<section class="bg-gradient-to-br from-[#f8fbff] via-[#eef5ff] to-[#f0fbf9] py-20 md:py-28 overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <div class:list={['grid gap-16 items-center', showCard ? 'md:grid-cols-2' : 'max-w-3xl']}>

      <!-- Copy -->
      <div>
        {eyebrow && (
          <p class="text-xs font-bold uppercase tracking-widest text-teal mb-5">{eyebrow}</p>
        )}

        <h1 class="text-4xl md:text-5xl font-extrabold text-slate leading-[1.1] tracking-tight mb-5">
          {titleAccent
            ? (<>
                {title.split(titleAccent)[0]}
                <span class="text-blue relative inline-block">
                  {titleAccent}
                  <span class="absolute -bottom-0.5 left-0 right-0 h-[3px] bg-teal rounded-full"></span>
                </span>
                {title.split(titleAccent)[1]}
              </>)
            : title
          }
        </h1>

        <p class="text-lg text-slate-mid leading-relaxed mb-8 max-w-lg">{body}</p>

        <div class="flex flex-wrap gap-3">
          <a href={primaryCta.href} class="btn-primary">{primaryCta.label}</a>
          {secondaryCta && (
            <a href={secondaryCta.href} class="btn-outline">{secondaryCta.label}</a>
          )}
        </div>

        <p class="mt-6 text-sm text-slate-soft flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <circle cx="8" cy="8" r="7" stroke="#0D9A8A" stroke-width="1.5"/>
            <path d="M5 8L7 10L11 6" stroke="#0D9A8A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Clear guidance from a registered clinician — no hype, no guessing
        </p>
      </div>

      <!-- Optional tracker card -->
      {showCard && (
        <div class="relative flex justify-center">
          <div class="bg-white rounded-2xl shadow-card-md p-8 border border-gray-100 w-full max-w-sm">
            <p class="text-xs font-semibold uppercase tracking-widest text-slate-soft mb-1">
              Tendon Load Tracker
            </p>
            <p class="text-base font-bold text-slate mb-6">Achilles Tendon — Week 4 of 12</p>

            {[
              { label: 'Tissue Capacity',   pct: 68,  color: 'bg-blue'   },
              { label: 'Progressive Load',  pct: 55,  color: 'bg-teal'   },
              { label: 'Pain Response',     pct: 22,  color: 'bg-orange-400' },
            ].map(bar => (
              <div class="mb-3 last:mb-0">
                <div class="flex justify-between text-xs font-medium text-slate-soft mb-1.5">
                  <span>{bar.label}</span>
                  <span>{bar.pct}%</span>
                </div>
                <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
                  <div
                    class={`h-full rounded-full ${bar.color} transition-all duration-700`}
                    style={`width: ${bar.pct}%`}
                  ></div>
                </div>
              </div>
            ))}

            <div class="mt-5 pt-4 border-t border-gray-100 flex items-center justify-between">
              <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-teal-light text-teal">On Track</span>
              <span class="text-xs text-slate-soft">Next: Add single-leg heel drops</span>
            </div>
          </div>

          <!-- Floating badge -->
          <div class="absolute -bottom-4 -left-6 bg-white rounded-xl shadow-card px-4 py-3 flex items-center gap-3 border border-gray-100">
            <div class="w-9 h-9 rounded-lg bg-teal-light flex items-center justify-center flex-shrink-0">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path d="M3 9L7 13L15 5" stroke="#0D9A8A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-slate leading-none mb-0.5">Tendon adapts to load</p>
              <p class="text-xs text-slate-soft">Structured program · Not just rest</p>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</section>
